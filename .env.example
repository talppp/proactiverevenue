# Copy to .env and fill in. NEVER commit .env.

# "memory" runs entirely in-process (demo, tests).
# postgresql://user:pass@host:5432/db connects to a real Postgres.
DB_URL=memory

# Anthropic key for L3 classifiers. Leave blank to use deterministic stub classifier.
ANTHROPIC_API_KEY=

# Optional: error tracking (free tier OK).
SENTRY_DSN=

LOG_LEVEL=INFO
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=400
LLM_DAILY_USD_CEILING=10.0
CONFIDENCE_FLOOR=0.55
